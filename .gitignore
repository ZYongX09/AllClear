# dependencies
node_modules/

# build output
dist/
.next/
.vinext/
.cloudflare/
build/

# generated Worker runtime types — `wrangler types` (run by `npm run typecheck`)
# regenerates this. Committing it adds ~16k lines of generated declarations and
# trips the security scanner on standard method signatures such as
# URLPattern.exec(), Container.exec() and D1Database.exec(), which are
# declarations rather than executable code.
apps/api/worker-configuration.d.ts

# env & secrets — never commit these
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# local test artifacts
coverage/
*.tsbuildinfo

# per-session tool state (security-scan hook bookkeeping) — machine local
.mimosa/
