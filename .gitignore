# dependencies
node_modules/

# build output
dist/
.next/
.vinext/
.cloudflare/
build/

# Generated Worker types — `npm run typecheck` regenerates this with
# `wrangler types --include-runtime=false`, so it holds only the small Env
# interface. Runtime types (D1Database, KVNamespace, ...) come from the
# @cloudflare/workers-types package instead; generating them here produced a
# 16k-line file whose standard method signatures (URLPattern.exec(),
# Container.exec(), D1Database.exec()) were false-positived as command
# injection by the security scanner.
apps/api/worker-configuration.d.ts

# env & secrets — never commit these
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# local test artifacts
coverage/
*.tsbuildinfo

# Wrangler's local state: the miniflare-backed D1/KV/cache databases and
# deployment metadata under `.wrangler/`. Not a build input, and it holds real
# rows once a migration has been applied locally. The test suite cleans up after
# itself so this directory is usually empty, which is exactly why it is worth
# ignoring now rather than after someone commits a database by accident.
.wrangler/

# per-session tool state (security-scan hook bookkeeping) — machine local
.mimosa/
