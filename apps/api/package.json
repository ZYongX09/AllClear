{
  "name": "allclear-api",
  "private": true,
  "version": "0.0.0",
  "description": "allclear API Worker: public read API, internal admin API, probe scheduler",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply allclear-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply allclear-db --remote"
  },
  "dependencies": {
    "@allclear/shared": "file:../../packages/shared",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "latest",
    "vitest": "^4.1.11",
    "wrangler": "^4.88.0"
  }
}
