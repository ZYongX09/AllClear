{
  // Wrangler config, not the `cf` typed config (`cloudflare.config.ts`).
  //
  // vinext and `cf` both support a typed `cloudflare.config.ts`, and that is
  // what `npm create cloudflare` scaffolds today. It is not used here because
  // `cf` resolves credentials only from CLOUDFLARE_API_TOKEN or its own OAuth
  // profile (`cf auth login`) — it does not reuse the Wrangler OAuth session
  // that CI and most existing checkouts already have. The Wrangler route
  // deploys with credentials that already exist. See docs/spec/m0-findings.md.
  //
  // `account_id` is deliberately absent: this repository is published for
  // others, so the account is supplied per environment via CLOUDFLARE_ACCOUNT_ID.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allclear-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],

  // The API Worker has no public route. It is reachable only through the
  // Service Binding declared by the web Worker. This is the primary boundary;
  // INTERNAL_KEY (a secret, set with `wrangler secret put`) is a second,
  // independent check, because reachability through a Service Binding is not
  // authorisation.
  "workers_dev": false,
  "observability": { "enabled": true },

  // Non-secret configuration. Secrets (`INTERNAL_KEY`, `UNSUBSCRIBE_HMAC_KEY`)
  // are set with `wrangler secret put` and are declared in types/env.d.ts.
  "vars": {
    // Absolute origin used to build links in outbound email and the Atom feed.
    // A relative unsubscribe link is useless in a mail client, so notification
    // is skipped while this is empty. Override per environment.
    "PUBLIC_BASE_URL": "",
    // Envelope sender. The domain must be verified with the email provider
    // before the `EMAIL` binding can be used.
    "EMAIL_FROM": "status@localhost",
    // Probe targets processed per cron tick. Clamped to the v1 cap of 20.
    "MAX_TARGETS_PER_RUN": "20"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allclear-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SNAPSHOT_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // The prober, the uptime rollups and the retention pass all run from this
  // single cron trigger. One trigger rather than several because the steps are
  // ordered by dependency — probes produce the impacts the rollups read, and the
  // rollups must happen before retention deletes the raw observations they are
  // computed from.
  //
  // Note the `send_email` binding is deliberately *not* declared here: adding it
  // makes `wrangler deploy` fail on any account without a verified sending
  // domain. Without it, mail is recorded rather than delivered — see
  // docs/spec/subscriptions.md.
  "triggers": { "crons": ["* * * * *"] }
}
